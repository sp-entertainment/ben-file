{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Ben Notes Format",
	"scopeName": "source.ben",
	"patterns": [
		{
			"include": "#section-headers"
		},
		{
			"include": "#task-done"
		},
		{
			"include": "#task-active"
		},
		{
			"include": "#task-waiting"
		},
		{
			"include": "#task-target"
		},
		{
			"include": "#task-notstarted"
		},
		{
			"include": "#urls"
		}
	],
	"repository": {
		"section-headers": {
			"patterns": [
				{
					"name": "markup.heading.ben",
					"match": "^[A-Z][A-Z ]*$"
				},
				{
					"name": "markup.heading.child.ben",
					"match": "^\\s+[A-Z][A-Z ]*$"
				}
			]
		},
		"task-done": {
			"patterns": [
				{
					"name": "markup.bold.done.ben",
					"match": "^(\\s*)(X)(\\s*-\\s*)(.*)$",
					"captures": {
						"2": {
							"name": "keyword.control.done.ben"
						},
						"3": {
							"name": "punctuation.separator.ben"
						},
						"4": {
							"name": "entity.name.task.done.ben"
						}
					}
				}
			]
		},
		"task-active": {
			"patterns": [
				{
					"name": "markup.bold.active.ben",
					"match": "^(\\s*)(O)(\\s*-\\s*)(.*)$",
					"captures": {
						"2": {
							"name": "keyword.control.active.ben"
						},
						"3": {
							"name": "punctuation.separator.ben"
						},
						"4": {
							"name": "entity.name.task.active.ben"
						}
					}
				}
			]
		},
		"task-waiting": {
			"patterns": [
				{
					"name": "markup.bold.waiting.ben",
					"match": "^(\\s*)(W)(\\s*-\\s*)(.*)$",
					"captures": {
						"2": {
							"name": "keyword.control.waiting.ben"
						},
						"3": {
							"name": "punctuation.separator.ben"
						},
						"4": {
							"name": "entity.name.task.waiting.ben"
						}
					}
				}
			]
		},
		"task-target": {
			"patterns": [
				{
					"name": "markup.bold.target.ben",
					"match": "^(\\s*)(T)(\\s*-\\s*)(.*)$",
					"captures": {
						"2": {
							"name": "keyword.control.target.ben"
						},
						"3": {
							"name": "punctuation.separator.ben"
						},
						"4": {
							"name": "entity.name.task.target.ben"
						}
					}
				}
			]
		},
		"task-notstarted": {
			"patterns": [
				{
					"name": "markup.bold.notstarted.ben",
					"match": "^(\\s*)(-)(\\s+)(.*)$",
					"captures": {
						"2": {
							"name": "keyword.control.notstarted.ben"
						},
						"3": {
							"name": "punctuation.separator.ben"
						},
						"4": {
							"name": "entity.name.task.notstarted.ben"
						}
					}
				}
			]
		},
		"urls": {
			"patterns": [
				{
					"name": "markup.underline.link.ben",
					"match": "https?://[^\\s]+"
				}
			]
		}
	}
}