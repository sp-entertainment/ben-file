{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Ben",
	"scopeName": "source.ben",
	"patterns": [
		{ "include": "#section-headers" },
		{ "include": "#task-done" },
		{ "include": "#task-active" },
		{ "include": "#task-waiting" },
		{ "include": "#task-target" },
		{ "include": "#task-plain" },
		{ "include": "#note" }
	],
	"repository": {
		"meta-info": {
			"match": "(\\([^)]*\\))",
			"name": "string.quoted.other.ben"
		},

		"urls": {
			"match": "https?://[^\\s]+",
			"name": "markup.underline.link.ben"
		},

		"section-headers": {
			"patterns": [
				{
					"match": "^[A-Z][A-Z0-9 /&]+\\s*$",
					"name": "markup.heading.ben"
				},
				{
					"match": "^\\s+[A-Z][A-Z0-9 /&]+\\s*$",
					"name": "markup.heading.child.ben"
				}
			]
		},

		"task-done": {
			"patterns": [
				{
					"name": "meta.task.done.ben",
					"begin": "^(\\s*)(X)(\\s*-\\s*)",
					"beginCaptures": {
						"2": { "name": "keyword.control.done.ben" },
						"3": { "name": "punctuation.separator.ben" }
					},
					"contentName": "meta.task.done.ben",
					"end": "$",
					"patterns": [
						{ "include": "#meta-info" },
						{ "include": "#urls" }
					]
				}
			]
		},

		"task-active": {
			"patterns": [
				{
					"name": "meta.task.active.ben",
					"begin": "^(\\s*)(O)(\\s*-\\s*)",
					"beginCaptures": {
						"2": { "name": "keyword.control.active.ben" },
						"3": { "name": "punctuation.separator.ben" }
					},
					"contentName": "meta.task.active.ben",
					"end": "$",
					"patterns": [
						{ "include": "#meta-info" },
						{ "include": "#urls" }
					]
				}
			]
		},

		"task-waiting": {
			"patterns": [
				{
					"name": "meta.task.waiting.ben",
					"begin": "^(\\s*)(W)(\\s*-\\s*)",
					"beginCaptures": {
						"2": { "name": "keyword.control.waiting.ben" },
						"3": { "name": "punctuation.separator.ben" }
					},
					"contentName": "meta.task.waiting.ben",
					"end": "$",
					"patterns": [
						{ "include": "#meta-info" },
						{ "include": "#urls" }
					]
				}
			]
		},

		"task-target": {
			"patterns": [
				{
					"name": "meta.task.target.ben",
					"begin": "^(\\s*)(T)(\\s*-\\s*)",
					"beginCaptures": {
						"2": { "name": "keyword.control.target.ben" },
						"3": { "name": "punctuation.separator.ben" }
					},
					"contentName": "meta.task.target.ben",
					"end": "$",
					"patterns": [
						{ "include": "#meta-info" },
						{ "include": "#urls" }
					]
				}
			]
		},

		"task-plain": {
			"patterns": [
				{
					"name": "meta.task.notstarted.ben",
					"begin": "^(\\s*)(-)(\\s+)",
					"beginCaptures": {
						"2": { "name": "keyword.control.notstarted.ben" },
						"3": { "name": "punctuation.separator.ben" }
					},
					"contentName": "meta.task.notstarted.ben",
					"end": "$",
					"patterns": [
						{ "include": "#meta-info" },
						{ "include": "#urls" }
					]
				}
			]
		},

		"note": {
			"patterns": [
				{
					"begin": "^(\\s*)(?![XOWT]\\s*-\\s)(?!-\\s)(?=\\S)",
					"end": "$",
					"contentName": "string.unquoted.ben",
					"patterns": [
						{ "include": "#meta-info" },
						{ "include": "#urls" }
					]
				}
			]
		}
	}
}
